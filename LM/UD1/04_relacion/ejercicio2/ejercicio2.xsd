<?xml version="1.0" encoding="UTF-8"?>

<!-- Se te da el siguiente XML (no válido aún). Debes crear el XSD que valide su estructura:

<pedidos>
  <pedido codigo="A101">
    <cliente>
      <nombre>Ana García</nombre>
      <email>ana@example.com</email>
      <telefono>678-123-456</telefono>
    </cliente>
    <productos>
      <producto>
        <nombre>Ratón inalámbrico</nombre>
        <precio>19.95</precio>
        <cantidad>2</cantidad>
      </producto>
      <producto>
        <nombre>Teclado mecánico</nombre>
        <precio>79.99</precio>
        <cantidad>1</cantidad>
      </producto>
    </productos>
    <estado>Enviado</estado>
  </pedido>
</pedidos>

-->

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="pedidos">
        <xs:complexType>
            <xs:sequence>
                <xs:element name='pedido'>
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="cliente">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="nombre">
                                            <xs:simpleType>
                                                <xs:restriction base="xs:string">
                                                    <xs:pattern value="[A-Z].* [A-Z].*"></xs:pattern>
                                                </xs:restriction>
                                            </xs:simpleType>
                                        </xs:element>
                                        <xs:element name="email" maxOccurs="1">
                                            <xs:simpleType>
                                                <xs:restriction base="xs:string">
                                                    <xs:pattern value="[^@]+@[^@]+"></xs:pattern>
                                                </xs:restriction>
                                            </xs:simpleType>
                                        </xs:element>
                                        <xs:element name="telefono" maxOccurs="1">
                                            <xs:simpleType>
                                                <xs:restriction base="xs:string">
                                                    <xs:pattern value="\d{3}-\d{3}-\d{3}"></xs:pattern>
                                                </xs:restriction>
                                            </xs:simpleType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="productos">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="producto" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="nombre" minOccurs="1" maxOccurs="1"> <!-- TERMINAR -->
                                                        <xs:simpleType>
                                                            <xs:restriction base="xs:string">
                                                                <xs:pattern value="[A-Z].*"></xs:pattern>
                                                            </xs:restriction>
                                                        </xs:simpleType>
                                                    </xs:element>
                                                    <xs:element name="precio" minOccurs="1" maxOccurs="1"> <!-- TERMINAR? -->
                                                    </xs:element>
                                                    <xs:element name="cantidad"> <!-- TERMINAR -->
                                                    </xs:element>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="estado" maxOccurs="1">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="Pendiente"/>
                                        <xs:enumeration value="Enviado"/>
                                        <xs:enumeration value="Entregado"/>
                                        <xs:enumeration value="Cancelado"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                        </xs:sequence>
                        <xs:attribute name="codigo" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>